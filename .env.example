# Postgres connection string. In Vercel, adding a Neon (Postgres) database from the
# Storage tab fills this in for you. Leave it empty locally and the app uses a small
# file-based database in .data/ so you can run it with zero setup.
DATABASE_URL=

# REQUIRED on Vercel. The shared password for /admin (Anthony and Jadon both use it).
ADMIN_PASSWORD=

# Any long random string. Signs the login cookie. Generate one with: openssl rand -hex 32
AUTH_SECRET=
